{
  "name": "ng-fixit-workspace",
  "version": "0.0.0",
  "description": "Visual feedback and UI annotation library for Angular and AI coding agents.",
  "keywords": [
    "angular",
    "ai-agent",
    "coding-agent",
    "visual-feedback",
    "ui-annotation",
    "browser-annotation",
    "developer-tools"
  ],
  "scripts": {
    "ng": "ng",
    "start": "ng serve ng-fixit-demo",
    "build": "ng build ng-fixit",
    "watch": "ng build ng-fixit --watch --configuration development",
    "test": "ng test ng-fixit",
    "test:demo": "ng test ng-fixit-demo",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "quality": "pnpm run lint && pnpm run format",
    "prepare": "husky"
  },
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.2",
    "@angular/cli": "^22.1.2",
    "@angular/compiler-cli": "^22.1.0",
    "husky": "^9.1.7",
    "jsdom": "^28.0.0",
    "lint-staged": "^17.0.7",
    "ng-packagr": "^22.1.0",
    "oxfmt": "^0.53.0",
    "oxlint": "^1.68.0",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
}
